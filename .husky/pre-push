#!/bin/sh
# pre-push: full workspace gate (typecheck + tests).
# Skipped for docs-only pushes (only *.md files changed) — markdown can't
# affect the build, and the full suite costs ~50s.

changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions (all-zero local sha).
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    range="$remote_sha..$local_sha"
  else
    # New branch: diff against the merge base with origin/HEAD, else last commit.
    base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null)"
    if [ -n "$base" ]; then range="$base..$local_sha"; else range="${local_sha}^..${local_sha}"; fi
  fi
  changed="$changed $(git diff --name-only "$range" 2>/dev/null)"
done

non_docs=""
for f in $changed; do
  case "$f" in
    *.md) ;;
    *) non_docs="yes" ;;
  esac
done

if [ -z "$non_docs" ]; then
  echo "pre-push: docs-only change — skipping typecheck + tests"
  exit 0
fi

pnpm typecheck
pnpm test
