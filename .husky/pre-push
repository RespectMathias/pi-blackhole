#!/bin/sh
# pre-push: full workspace gate (typecheck + tests).
# Skipped for docs-only pushes (only *.md files changed) — markdown can't
# affect the build, and the full suite costs ~50s.
#
# NOTE: husky runs hooks with `sh -e`, so every fallible command here must be
# guarded (if/||) — a bare `$(git ...)` failing would abort the whole hook.
# This bit new-ref pushes (new branches/tags) when origin/HEAD is absent.

changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions (all-zero local sha).
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  case "$local_ref" in
    refs/tags/*)
      # Tags are release artifacts — always run the full gate, no docs-only
      # shortcut (the tree the tag points at was already gated on its branch
      # push; this guards the current checkout too).
      changed="tags"
      continue
      ;;
  esac
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    range="$remote_sha..$local_sha"
  else
    # New branch: diff against the merge base with origin/HEAD, else last commit.
    # origin/HEAD may be absent (not created by clone/pull) — fall back then.
    if base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null)"; then
      range="$base..$local_sha"
    else
      range="${local_sha}^..${local_sha}"
    fi
  fi
  changed="$changed $(git diff --name-only "$range" 2>/dev/null || true)"
done

non_docs=""
for f in $changed; do
  case "$f" in
    *.md) ;;
    *) non_docs="yes" ;;
  esac
done

if [ -z "$non_docs" ]; then
  echo "pre-push: docs-only change — skipping typecheck + tests"
  exit 0
fi

pnpm typecheck
pnpm test
